# Supabase project: contentadmin (org: Ledgr)
NEXT_PUBLIC_SUPABASE_URL=https://pfgrbkaloadwgtumkali.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zH52QPHYAuDgFV4ayJszWg_B6anMVTg

# Public site URL, used for the magic-link auth redirect and the YouTube
# OAuth redirect_uri. Set this to the deployed Vercel URL (or
# http://localhost:3000 for local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Supabase dashboard -> Settings -> API -> service_role
# secret. Used only by the no-session publish-due cron job (bypasses
# RLS) — never prefix this NEXT_PUBLIC_ and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. console.anthropic.com -> API Keys. Powers "Draft with AI"
# metadata generation (title/description/tags/trend score).
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

# Server-only. From the Google Cloud OAuth client used for the YouTube
# Data API (APIs & Services -> Credentials). Needs the YouTube Data API
# v3 enabled and an OAuth consent screen with the youtube.upload and
# youtube.force-ssl scopes; add {NEXT_PUBLIC_SITE_URL}/auth/youtube/callback
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. A secret string you choose yourself to protect
# /api/cron/publish-due from being triggered by anyone who finds the URL.
# Vercel Cron sends it automatically as a bearer token once set; without
# it the endpoint is unauthenticated (fine for local testing only).
CRON_SECRET=
